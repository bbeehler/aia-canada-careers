# Copy to .env.local for local development. In Cloudflare Pages, add these under
# Settings > Environment variables. Both values are in Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# HubSpot payment link for a non-member job posting (Commerce > Payment links).
# Until the HubSpot webhook is built, AIA staff mark payments received in the review queue.
VITE_NONMEMBER_PAYMENT_URL=
# HubSpot payment link for a non-member posting that is also featured (posting + featured add-on).
VITE_NONMEMBER_FEATURED_PAYMENT_URL=
